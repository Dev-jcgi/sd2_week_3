rules_version = '2';

// Reglas para la web de dinámicas (Semana 3 · Procesamiento del Backlog).
// Todos entran con autenticación anónima. Cada quien solo escribe sus propios datos;
// solo quien creó la sala puede controlarla.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost(code) {
      return get(/databases/$(database)/documents/rooms/$(code)).data.hostUid == request.auth.uid;
    }

    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z]{5}$')
        && request.resource.data.hostUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if false;

      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24;
        allow delete: if signedIn() && isHost(code);
      }

      match /answers/{answerId} {
        allow read: if signedIn();
        // Una respuesta por paso: el id empieza con el uid de quien responde y no se puede editar.
        allow create: if signedIn()
          && answerId.matches(request.auth.uid + '__.*')
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /results/{resultId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && resultId.matches(request.auth.uid + '__.*')
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Contadores agregados de aciertos por pregunta.
    match /stats/{statId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }
  }
}
